# Kırtasiye Stok ve Satış Sistemi Yapılandırması
APP_NAME="Kırtasiye Stok ve Satış Sistemi"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Veritabanı Seçimi: 'mysql' veya 'sqlite'
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kirtasiye_stok_satis
DB_USERNAME=root
DB_PASSWORD=

# Oturum Ayarları
SESSION_LIFETIME=7200
SESSION_SECURE=false

