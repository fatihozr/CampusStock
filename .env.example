# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore ile dışlanır; gerçek anahtarlar asla depoya girmez.

# Çalışma ortamı: local veya production
APP_ENV=local

# Uygulamanın kök adresi (canonical bağlantılar ve sitemap için)
APP_URL=http://localhost:8000

# Supabase proje adresi: Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase service_role anahtarı: yalnızca sunucuda kullanılır, tarayıcıya gönderilmez
SUPABASE_SERVICE_KEY=
