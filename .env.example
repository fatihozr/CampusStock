# CampusStock - Kırtasiye Sipariş ve Stok Yönetim Platformu
APP_NAME="CampusStock"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Veritabanı Seçimi: 'mysql', 'sqlite' veya 'supabase'
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kirtasiye_stok_satis
DB_USERNAME=root
DB_PASSWORD=

# Supabase (Opsiyonel / Cloud Veritabanı)
# Supabase proje adresi: Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase service_role anahtarı: yalnızca sunucuda kullanılır, tarayıcıya gönderilmez
SUPABASE_SERVICE_KEY=

# Oturum Ayarları
SESSION_LIFETIME=7200
SESSION_SECURE=false
