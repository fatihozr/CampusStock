<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Projects/envanter/

    # Stop rewriting if requested file or directory exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Rewrite all requests to index.php with r query parameter
    RewriteRule ^(.*)$ index.php?r=/$1 [QSA,L]
</IfModule>
